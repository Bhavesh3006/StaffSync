# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace with your actual user, URL-encoded password, and cluster host:
# Example: mongodb+srv://<username>:<password>@staffsynccluster.azhkeap.mongodb.net/staffsync?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/staffsync?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=7d

# Allowed Frontend Origin for CORS (e.g., https://your-app.vercel.app)
CLIENT_URL=https://your-frontend-domain.vercel.app

